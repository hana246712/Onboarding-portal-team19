{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumePlanEventsOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:${REGION}:${ACCOUNT_ID}:team19-plan-events"
    }
  ]
}
