{
  "info": {
    "name": "Team 19 – End-to-end test on the live site",
    "description": "Hana Anwar, issue #28. One full onboarding on the DEPLOYED site (Vercel + Neon): template -> plan -> every role does its tasks -> plan completes automatically -> dashboard, notifications and audit log show it. Creates its own test Staff and Customer accounts (emails end in @example.test) and one template, and deactivates/archives them at the end; the completed test plan stays as evidence. Run with: cd backend && npm run e2e:live (asks for a live Admin login; nothing is stored).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Only for the live API: this collection is the end-to-end test of the deployed site.",
          "if (pm.variables.get('baseUrl') !== 'https://team19-api.vercel.app') {",
          "  throw new Error('This collection is the end-to-end test of the live site: baseUrl must be https://team19-api.vercel.app');",
          "}",
          "if (!pm.variables.get('run')) pm.variables.set('run', Date.now().toString(36));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Live site and login",
      "item": [
        {
          "name": "API health on the live site",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('security headers on the live API', () => {",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "  pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('max-age');",
                  "});",
                  "if (pm.response.code >= 300) pm.execution.setNextRequest(null); // the rest of the flow needs this step"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 - check adminEmail / adminPassword', () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
                  "  pm.test('role Admin', () => pm.expect(pm.response.json().user.role).to.eql('Admin'));",
                  "  pm.variables.set('adminToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard before: completed plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard",
                "summary"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.variables.set('completedBefore', pm.response.json().plans.completed);"
                ]
              }
            }
          ]
        }
      ]
