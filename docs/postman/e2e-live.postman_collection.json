      "name": "2. Plan from the template (Hana Anwar's service)",
      "item": [
        {
          "name": "Admin creates the customer's plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "plans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateId\": {{templateId}},\n  \"customerId\": {{customerId}},\n  \"startDate\": \"{{today}}\",\n  \"staffOwnerId\": {{staffId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('today', new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const { plan, tasks } = pm.response.json();",
                  "const add = (d, n) => new Date(Date.parse(d + 'T00:00:00Z') + n * 864e5).toISOString().slice(0, 10);",
                  "const t0 = pm.variables.get('today');",
                  "pm.test('3 tasks copied with due dates from the offsets', () => pm.expect(tasks.map((t) => t.dueDate)).to.eql([t0, add(t0, 3), add(t0, 5)]));",
                  "pm.test('owners: staff, customer, staff', () => pm.expect(tasks.map((t) => t.assignee.id)).to.eql([pm.variables.get('staffId'), pm.variables.get('customerId'), pm.variables.get('staffId')]));",
                  "pm.variables.set('planId', plan.id);",
                  "pm.variables.set('kickoffId', tasks[0].id); pm.variables.set('uploadId', tasks[1].id); pm.variables.set('creditId', tasks[2].id);",
                  "if (pm.response.code >= 300) pm.execution.setNextRequest(null); // the rest of the flow needs this step"
                ]
              }
            }
          ]
        },
